{
  "name": "leaguecred",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx src/db/migrate-deploy.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude **/*.integration.test.ts",
    "test:integration": "pnpm db:test:up && DATABASE_URL=postgresql://leaguecred:leaguecred@localhost:54330/leaguecred_test pnpm db:migrate && DATABASE_URL=postgresql://leaguecred:leaguecred@localhost:54330/leaguecred_test pnpm db:seed && DATABASE_URL=postgresql://leaguecred:leaguecred@localhost:54330/leaguecred_test BETTER_AUTH_SECRET=leaguecred-integration-test-secret vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:deploy": "tsx src/db/migrate-deploy.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:catalog": "tsx src/db/seed-catalog.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "db:test:down": "docker compose stop postgres-test",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres && pnpm db:migrate && pnpm db:seed",
    "fixtures:sync": "tsx src/jobs/sync-fixtures.ts",
    "teams:logos": "tsx src/jobs/sync-team-logos.ts",
    "settle": "tsx src/jobs/settle-picks.ts",
    "remind": "tsx src/jobs/send-lock-reminders.ts",
    "notify:specialist-locks": "tsx src/jobs/notify-specialist-locks.ts",
    "admin:grant": "tsx src/jobs/grant-admin.ts",
    "teams:dedupe": "tsx src/jobs/dedupe-teams.ts",
    "fixtures:dedupe": "tsx src/jobs/dedupe-fixtures.ts",
    "matchweeks:merge": "tsx src/jobs/merge-matchweeks.ts",
    "teams:names": "tsx src/jobs/refresh-team-names.ts",
    "league:drop": "tsx src/jobs/drop-league.ts",
    "team:split": "tsx src/jobs/split-team.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:full": "pnpm check && pnpm test:integration"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
